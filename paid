local modeNames={[1]="1v1",[2]="2v2",[3]="3v3"}
local modePredictor,modeArena,modeTick,largestTeamSize=nil,nil,nil,0
local function currentMode()
    local p=findPredictor()
    if not p or not p.carsById then
        modePredictor=nil;modeArena=nil;modeTick=nil;largestTeamSize=0
        return nil
    end
    if p~=modePredictor or p.arena~=modeArena or (modeTick and p.tick and p.tick<modeTick) then
        modePredictor=p;modeArena=p.arena;largestTeamSize=0
    end
    modeTick=p.tick
    local blue,orange=0,0
    for _,car in pairs(p.carsById) do
        if car.team==0 then blue+=1 elseif car.team==1 then orange+=1 end
    end
    -- Do not shrink a match when a player leaves or joins late.
    local largest=math.max(blue,orange)
    if largest>=1 and largest<=3 then largestTeamSize=math.max(largestTeamSize,largest) end
    if blue<1 or orange<1 or blue~=orange then return nil end
    return modeNames[largestTeamSize]
end
local appliedMode=nil
local modeDefaults={["1v1"]="TromsoFR-Newest",["2v2"]="KusoV1",["3v3"]="KusoV1.5"}
function Bot:RefreshMode()
    if #self.Models==0 then return false,"Waiting for model catalog" end
    local mode=currentMode()
    if not mode then self.DetectedMode=nil;return false,"Waiting for both teams" end
    self.DetectedMode=mode
    local remembered=self.ModeModels[mode]
    if not remembered or not modelsToLabels[remembered] then return false,"Waiting for saved model" end
    if not modelGroups[remembered] or not table.find(modelGroups[remembered],mode) then
        remembered=modeDefaults[mode]
        if not modelsToLabels[remembered] then return false,"Waiting for mode default" end
        self.ModeModels[mode]=remembered
    end
    if appliedMode==mode and self.SelectedMode==mode and self.Model==remembered then return true end
    -- Commit only after the actual model switch succeeds.
    self.SelectedMode=mode
    if remembered~=self.Model then self:SelectModel(remembered) end
    appliedMode=mode
    syncingUI=true;syncModelDropdowns();syncingUI=false
    return true
end
