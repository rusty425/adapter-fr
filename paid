        if not ok or type(response)~="table" then
            return {StatusCode=0,Body="HTTP request failed",Success=false}
        end
        local status=tonumber(response.StatusCode or response.Status)
        if not status or status%1~=0 or status<100 or status>599 then
            return {StatusCode=0,Body="HTTP response status unavailable",Success=false}
        end
        return {StatusCode=status,Body=type(response.Body)=="string" and response.Body or "",
            Success=status>=200 and status<300,Headers=response.Headers}
    end
end
local function signal(value)
