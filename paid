local createDiagnostics=(function()
-- Private in-memory support log. No files, network, game logs or global hooks.
return function(ctx)
    ctx=ctx or {}
    local log={Entries={},Revision=0,Omitted=0,MaxEntries=150,Version="2026.10.23-logs.7"}
    local clock=ctx.clock or os.clock
    local function secretName(name)
        name=name:lower():gsub("[^%w]","")
        return name:find("token",1,true) or name:find("key",1,true) or name:find("license",1,true)
            or name:find("password",1,true) or name:find("authorization",1,true)
            or name:find("cookie",1,true) or name:find("hwid",1,true) or name=="deviceid"
    end
    function log:Sanitize(value,limit)
        local text=type(value)=="string" and value or type(value)=="number" and tostring(value) or "Unspecified error"
        -- Redact before truncating: a credential crossing the cutoff must not leak.
        if #text>16384 then return "Oversized error details omitted" end
        if ctx.secrets then
            local ok,secrets=pcall(ctx.secrets)
            if ok and type(secrets)=="table" then
                for _,secret in ipairs(secrets) do
                    if type(secret)=="string" and #secret>0 then
                        text=text:gsub(secret:gsub("(%W)","%%%1"),function() return "[redacted]" end)
                    end
                end
            end
        end
        text=text:gsub("https?://[^%s<>\"']+","[URL omitted]")
        -- Omit the whole message if it contains a credential assignment. This
        -- also covers values placed on another line in formatted JSON/errors.
        for name in text:gmatch("([%w_%-]+)[\"']?%s*[:=]") do
            if secretName(name) then return "[sensitive details omitted]" end
        end
        local lines={}
        for line in (text.."\n"):gmatch("(.-)\n") do
            local sensitive=false
            for name in line:gmatch("([%w_%-]+)[\"']?%s*[:=]") do
                if secretName(name) then sensitive=true;break end
            end
            if sensitive then line="[sensitive details omitted]" end
            lines[#lines+1]=line
        end
        text=table.concat(lines,"\n"):gsub("[%w_%-]+",function(word)
            -- Do not export unlabelled opaque session/device/credential strings.
            return #word>=24 and "[opaque value omitted]" or word
        end):gsub("[%z\1-\8\11\12\14-\31\127]","")
        limit=limit or 640
        if #text>limit then text=text:sub(1,limit).." [truncated]" end
        return text
    end
    local function stamp()
        if ctx.timestamp then
            local ok,value=pcall(ctx.timestamp)
            if ok and type(value)=="string" then return value:sub(1,32) end
        end
        return string.format("+%.1fs",clock())
    end
    function log:Add(level,source,message)
        level=(level=="ERROR" or level=="WARN") and level or "INFO"
        source=self:Sanitize(source,96);message=self:Sanitize(message)
        local now=clock();local last=self.Entries[#self.Entries]
        if last and last.Level==level and last.Source==source and last.Message==message and now-last.At<5 then
            last.Count+=1;last.At=now;last.Last=stamp()
        else
            if #self.Entries>=self.MaxEntries then table.remove(self.Entries,1);self.Omitted+=1 end
            self.Entries[#self.Entries+1]={Level=level,Source=source,Message=message,At=now,First=stamp(),Last=stamp(),Count=1}
        end
        self.Revision+=1
    end
    function log:Clear()
        table.clear(self.Entries);self.Omitted=0;self.Revision+=1
        if self.ClearSaved then pcall(self.ClearSaved) end
    end
    function log:Line(entry)
        local repeatText=entry.Count>1 and " (x"..entry.Count..", last "..entry.Last..")" or ""
        return "["..entry.First.."] "..entry.Level.." / "..entry.Source..": "..entry.Message..repeatText
    end
    function log:Recent()
        local rows={}
        for i=math.max(1,#self.Entries-7),#self.Entries do rows[#rows+1]=self:Line(self.Entries[i]) end
        return #rows>0 and table.concat(rows,"\n\n") or "No log entries."
    end
    function log:Export()
        local rows={"Dead Wire support log","Build: "..self.Version}
        if ctx.context then
            local ok,values=pcall(ctx.context)
            if ok and type(values)=="table" then
                for _,name in ipairs({"Edition","Runtime","Executor","Game","Mode","Bot","Enabled","Transport","Tick","RTT","Errors",
                    "LastAttemptMs","ClientPrepareMs","ClientTransportMs","ClientDecodeMs","ServerBridgeMs","ServerComputeMs","LastRejectedMs","ControlState","ControlHoldSeconds"}) do
                    local value=values[name]
                    if type(value)=="boolean" then value=tostring(value) end
                    if type(value)=="string" or type(value)=="number" then rows[#rows+1]=name..": "..self:Sanitize(value,120) end
                end
            end
        end
        rows[#rows+1]="Recent entries: "..#self.Entries.." / "..self.MaxEntries.."; older entries omitted: "..self.Omitted
        rows[#rows+1]=""
        for _,entry in ipairs(self.Entries) do rows[#rows+1]=self:Line(entry) end
        -- Re-sanitize entries too, in case a credential changed since insertion.
        local clean={}
        for _,row in ipairs(rows) do clean[#clean+1]=self:Sanitize(row,900) end
        return table.concat(clean,"\n")
    end
    function log:CleanReport(text)
        if type(text)~="string" or #text>150000 or not text:match("^Dead Wire support log") then return nil end
        local rows={}
        for line in (text.."\n"):gmatch("(.-)\n") do
            if #rows>=250 then break end
            rows[#rows+1]=self:Sanitize(line,900)
        end
        return table.concat(rows,"\n")
    end
    function log:CopyText(text)
        if type(ctx.copy)=="function" then
            local ok=pcall(ctx.copy,text)
            if ok then return true,"copied" end
        end
        if type(ctx.manualCopy)=="function" then
            local ok=pcall(ctx.manualCopy,text)
            if ok then return true,"manual" end
        end
        self:Add("WARN","Logs","Clipboard unavailable; the log can still be viewed here.")
        return false,"unavailable"
    end
    function log:Copy() return self:CopyText(self:Export()) end
    return log
end

end)()
local createStartupJournal=(function()
-- Two fixed, bounded, redacted startup reports. No per-frame file writes.
return function(ctx)
    local journal={Previous=nil,Available=type(ctx.write)=="function",Saved=false}
    local function read(path)
        if type(ctx.read)~="function" then return nil end
        local ok,value=pcall(ctx.read,path)
        if not ok or type(value)~="string" or #value>150000 then return nil end
        return ctx.clean(value)
    end
    local function write(path,text)
        if not journal.Available then return false end
        local ok,result=pcall(ctx.write,path,text)
        if not ok or result==false then journal.Available=false;return false end
        return true
    end
    local last=read(ctx.path)
    journal.Previous=last or read(ctx.previousPath)
    if last then write(ctx.previousPath,last) end
    function journal:Save()
        self.Saved=write(ctx.path,ctx.current())
        return self.Saved
    end
    function journal:Clear()
        self.Previous=nil
        write(ctx.previousPath,"")
        self:Save()
    end
    return journal
end

end)()
