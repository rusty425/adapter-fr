-- Turbo social integration uses the existing UI senders and server events.
function Adapter:InitSocial()
    self.socialEvents={};self.confirmedGoal=nil;self.lastHorn=-math.huge
    local match=game:GetService("ReplicatedStorage"):FindFirstChild("Match")
    local event=match and match:FindFirstChild("Event")
    if not event or not event:IsA("RemoteEvent") then return end
    self.socialConnection=event.OnClientEvent:Connect(function(message)
        if not self.Running or type(message)~="table" then return end
        local session=self.source and self.source.session
        if not session then return end
        local kind=message.kind
        if kind=="goal" then
            self.confirmedGoal={session=session,blue=message.blue,orange=message.orange,team=message.team,at=os.clock()}
        end
        if kind=="say" or kind=="goal" or kind=="horn" then
            if #self.socialEvents>=32 then table.remove(self.socialEvents,1) end
            table.insert(self.socialEvents,{kind=kind,phrase=message.phrase,index=message.index,
                scorer=message.scorer,team=message.team,blue=message.blue,orange=message.orange,
                session=session,at=os.clock()})
            if kind=="horn" and message.index==session.index then self.lastHorn=os.clock() end
        end
    end)
end
function Adapter:SocialBindings()
    if self.socialScanning then return end
    if self.socialClient==self.client and self.quickChatUI and self.hornUI then return end
    if os.clock()-(self.lastSocialScan or -math.huge)<10 then return end
    self.lastSocialScan=os.clock();self.socialClient=self.client;self.quickChatUI=nil;self.hornUI=nil
    local classes={}
    for _,module in ipairs(loadedModules().list) do
        if module.Parent==self.client and (module.Name=="QuickChatUi" or module.Name=="HornWheel") then
            local ok,class=pcall(require,module)
            if ok then classes[module.Name]=class end
        end
    end
    if not next(classes) then return end
    self.socialScanning=true
    local started=os.clock()
    for i,value in ipairs(getgc(true)) do
        if not self.Running then self.socialScanning=false;return end
        if i%3000==0 and os.clock()-started>0.002 then task.wait();started=os.clock() end
        if type(value)=="table" and type(rawget(value,"hooks"))=="table" then
            local class=getmetatable(value)
            if classes.QuickChatUi and class==classes.QuickChatUi and value.gui and value.gui.Parent and type(value.hooks.say)=="function" then self.quickChatUI=value end
            if classes.HornWheel and class==classes.HornWheel and value.gui and value.gui.Parent and type(value.hooks.pick)=="function" then self.hornUI=value end
        end
