            end
            -- Sealed simulation objects expose normal reads but intentionally have no raw fields.
            if type(t.tick)=="number" and type(t.car)=="table" and type(t.ball)=="table" and type(t.car.body)=="table" and (typeof(t.car.body[self.fields.pos])=="vector" or typeof(t.car.body[self.fields.pos])=="Vector3") then
